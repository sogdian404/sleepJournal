<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".addEdit.AddEditFragment">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newRecordAdd"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/BedTime"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="normal"
            android:textSize="14sp"
            />

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/bedBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginTop="8dp"
            android:text="@string/setDateTime"
            app:icon="@drawable/ic_moon"
            app:iconGravity="textStart"
            />

        <!-- Время пробуждения -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/WakeUpTime"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="normal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wakeUpBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setDateTime"
            app:icon="@drawable/ic_sun"
            app:iconGravity="textStart" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/FallAsleepMinutes"
            app:boxBackgroundMode="outline">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/fallAsleepInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="15" />

        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/awakeningsCount"
            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/awakeningsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="0" />
        </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/sleepQuality"/>
        <LinearLayout
            android:id="@+id/qualitySelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            >
            <TextView
                android:id="@+id/quality1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/rating1"
                android:textSize="30sp"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:id="@+id/quality2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/rating2"
                android:textSize="30sp"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:id="@+id/quality3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/rating3"
                android:textSize="30sp"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:id="@+id/quality4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/rating4"
                android:textSize="30sp"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:id="@+id/quality5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/rating5"
                android:textSize="30sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
<com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:hint="@string/PreSleepNote"
    app:boxBackgroundMode="outline">
    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/preSleepNoteInput"
        android:gravity="top"
        android:minLines="2"
        android:maxLines="5"

        android:inputType="textCapSentences|textMultiLine"/>
</com.google.android.material.textfield.TextInputLayout>

        <!-- Заметка после сна -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Заметка после сна (необязательно)"
            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/postSleepNoteInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:minLines="2"
                android:maxLines="5"
                android:inputType="textCapSentences|textMultiLine" />

        </com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.button.MaterialButton
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/saveBtn"
    android:layout_marginTop="24dp"
    android:text="@string/saveBtnText"
    android:textAllCaps="false"
    android:layout_marginBottom="200dp"/>


    </LinearLayout>
</ScrollView>
</FrameLayout>